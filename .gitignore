# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
# 注意：这里原来是 `build/`，改成 `build/*` 是为了把 build/verify 那批交付脚本放进来
# —— git 不允许"父目录被排除后再重新包含里面的文件"，写 `!build/verify/` 也没用。
build/*
# 上一行原来还有 `Build/`（GitHub 模板带来的），这台机器上文件系统不分大小写，
# 它把整个 build 目录又盖掉了 —— 新写的交付脚本（gen_plugins.py 那批）永远进不了库。
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# ---- 本项目（ltool：MSVC + vcpkg 清单 + Inno）----
# build/verify 是交付闭环的脚本（deliver.ps1 / archtest.ps1 / 各探针），必须入库；
# build 底下别的一概不收（Release 的 dll、CMake 缓存、vcpkg 灌出来的 2.2GB）。
!build/verify/
build/verify/artest/
build/verify/picktest/
build/verify/*.out
build/verify/*_report.txt
# 安装包产物（21MB，每次交付都重打），只留源码
installer/
# tools/make_sdk.py 铺出来的 SDK 快照目录（发版产物，不进仓库）
sdk-out/
out/
*.user
.vs/
# 恢复工程时留下的重复副本（和 README.md 同一份内容）
README (1).md
.idea/
build/verify/patch_*.py
build/verify/add_*.py
build/verify/*.sh
build/verify/crashscan.ps1
build/verify/pngcost.ps1
build/verify/startapps.ps1

__pycache__/
*.pyc
.zcode/
